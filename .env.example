# Postgres (Supabase) — usar a connection string do POOLER (pgbouncer, porta 6543) aqui.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta (porta 5432) — usada só para rodar migrations do Prisma.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Supabase — em Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxx"
SUPABASE_SERVICE_ROLE_KEY="xxxx" # secreta — nunca expor ao cliente, só em API routes

# Mercado Pago — em https://www.mercadopago.com.br/developers/panel
MERCADOPAGO_ACCESS_TOKEN="xxxx"
MERCADOPAGO_WEBHOOK_SECRET="xxxx"
